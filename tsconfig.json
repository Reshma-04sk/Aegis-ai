{
  // Type-checks the no-build front end (plain ES modules with JSDoc) and the browser tests.
  // Nothing is emitted: the browser runs the same files the checker reads.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "paths": { "#api": ["./types/api.d.ts"] }
  },
  "include": ["src/aegis/static/js/**/*.js", "types/**/*.d.ts"]
}

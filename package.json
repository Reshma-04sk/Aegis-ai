{
  "name": "aegis-ai-web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && vite build --ssr src/prerender.tsx && node web/prerender.ts",
    "config": "uv run aegis-config > web/src/generated/config.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json",
    "format:check": "prettier --check \"web/**/*.{ts,tsx,css,html}\" \"tests/web/**/*.{ts,tsx}\" \"tests/e2e/**/*.mjs\" \"*.{mjs,ts}\" \"package.json\" \".github/**/*.yml\"",
    "test:unit": "vitest run --coverage",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/coverage-v8": "5.1.1",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "jsdom": "31.0.1",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  },
  "dependencies": {
    "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "gsap": "3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}

{
  // Strict type-checking for the React front end, its unit tests and the build scripts.
  // Vite compiles; tsc only checks (noEmit). Erasable syntax only, so Node can run the
  // prerender script directly.
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["web/**/*.ts", "web/**/*.tsx", "tests/web/**/*.ts", "tests/web/**/*.tsx", "vite.config.ts"]
}
